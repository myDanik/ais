{
  "tools": [
    {
      "name": "create_ppt",
      "description": "创建新的 PowerPoint 演示文稿",
      "inputSchema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "演示文稿标题"
          },
          "author": {
            "type": "string",
            "description": "演示文稿作者"
          },
          "subject": {
            "type": "string",
            "description": "演示文稿主题"
          },
          "company": {
            "type": "string",
            "description": "公司名称"
          },
          "revision": {
            "type": "string",
            "description": "修订版本号"
          },
          "layout": {
            "type": "string",
            "enum": [
              "LAYOUT_16x9",
              "LAYOUT_16x10",
              "LAYOUT_4x3",
              "LAYOUT_WIDE"
            ],
            "description": "幻灯片布局"
          },
          "rtlMode": {
            "type": "boolean",
            "description": "是否启用从右到左模式"
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "create_slide",
      "description": "创建新的幻灯片",
      "inputSchema": {
        "type": "object",
        "properties": {
          "background": {
            "type": "string"
          },
          "masterSlideName": {
            "type": "string",
            "description": "主幻灯片模板名称"
          },
          "sectionTitle": {
            "type": "string",
            "description": "节标题"
          },
          "hidden": {
            "type": "boolean",
            "description": "是否隐藏幻灯片"
          },
          "slideNumber": {
            "type": "boolean",
            "description": "是否显示幻灯片编号"
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "add_text",
      "description": "在当前幻灯片中添加文本",
      "inputSchema": {
        "type": "object",
        "properties": {
          "text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "text": {
                      "type": "string"
                    },
                    "options": {
                      "type": "object",
                      "additionalProperties": {}
                    }
                  },
                  "required": [
                    "text"
                  ],
                  "additionalProperties": false
                }
              }
            ],
            "description": "Text or formatted runs"
          },
          "x": {
            "type": "number",
            "description": "X坐标位置（英寸）"
          },
          "y": {
            "type": "number",
            "description": "Y坐标位置（英寸）"
          },
          "w": {
            "type": "number",
            "description": "文本框宽度（英寸）"
          },
          "h": {
            "type": "number",
            "description": "文本框高度（英寸）"
          },
          "fontSize": {
            "type": "number",
            "description": "字体大小"
          },
          "bold": {
            "type": "boolean",
            "description": "是否加粗"
          },
          "italic": {
            "type": "boolean",
            "description": "是否斜体"
          },
          "underline": {
            "type": "boolean",
            "description": "是否下划线"
          },
          "color": {
            "type": "string",
            "description": "文字颜色"
          },
          "align": {
            "type": "string",
            "enum": [
              "left",
              "center",
              "right",
              "justify"
            ],
            "description": "文本对齐方式"
          },
          "fontFace": {
            "type": "string",
            "description": "字体名称"
          },
          "valign": {
            "type": "string",
            "enum": [
              "top",
              "middle",
              "bottom"
            ],
            "description": "垂直对齐方式"
          },
          "margin": {
            "type": "number",
            "description": "边距"
          },
          "lineSpacing": {
            "type": "number",
            "description": "行间距"
          },
          "charSpacing": {
            "type": "number",
            "description": "字符间距"
          },
          "fill": {
            "type": "string",
            "description": "背景填充颜色"
          },
          "transparency": {
            "type": "number",
            "description": "透明度(0-100)"
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "save_ppt",
      "description": "保存 PowerPoint 演示文稿",
      "inputSchema": {
        "type": "object",
        "properties": {
          "filePath": {
            "type": "string",
            "description": "保存文件的路径"
          },
          "outputType": {
            "type": "string",
            "enum": [
              "stream",
              "base64",
              "binarystring",
              "blob",
              "nodebuffer",
              "uint8array"
            ],
            "description": "输出类型"
          },
          "returnData": {
            "type": "boolean",
            "description": "是否返回文件数据"
          }
        },
        "required": [
          "filePath"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "add_image",
      "description": "在当前幻灯片中添加图片",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "图片文件路径"
          },
          "data": {
            "type": "string",
            "description": "图片的base64数据"
          },
          "hyperlink": {
            "type": "string",
            "description": "图片超链接"
          },
          "x": {
            "type": "number",
            "description": "X坐标位置（英寸）"
          },
          "y": {
            "type": "number",
            "description": "Y坐标位置（英寸）"
          },
          "w": {
            "type": "number",
            "description": "图片宽度（英寸）"
          },
          "h": {
            "type": "number",
            "description": "图片高度（英寸）"
          },
          "rotate": {
            "type": "number",
            "description": "旋转角度"
          },
          "flipH": {
            "type": "boolean",
            "description": "水平翻转"
          },
          "flipV": {
            "type": "boolean",
            "description": "垂直翻转"
          },
          "transparency": {
            "type": "number",
            "description": "透明度(0-100)"
          }
        },
        "required": [
          "x",
          "y",
          "w",
          "h"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "add_shape",
      "description": "在当前幻灯片中添加形状",
      "inputSchema": {
        "type": "object",
        "properties": {
          "options": {
            "type": "object",
            "additionalProperties": {}
          },
          "shapeType": {
            "type": "string",
            "description": "形状类型（如：rect, ellipse, triangle等）"
          },
          "x": {
            "type": "number",
            "description": "X坐标位置（英寸）"
          },
          "y": {
            "type": "number",
            "description": "Y坐标位置（英寸）"
          },
          "w": {
            "type": "number",
            "description": "形状宽度（英寸）"
          },
          "h": {
            "type": "number",
            "description": "形状高度（英寸）"
          },
          "fill": {
            "type": "string",
            "description": "填充颜色"
          },
          "line": {
            "type": "string",
            "description": "边框颜色"
          },
          "lineSize": {
            "type": "number",
            "description": "边框粗细"
          },
          "rotate": {
            "type": "number",
            "description": "旋转角度"
          },
          "flipH": {
            "type": "boolean",
            "description": "水平翻转"
          },
          "flipV": {
            "type": "boolean",
            "description": "垂直翻转"
          }
        },
        "required": [
          "shapeType",
          "x",
          "y",
          "w",
          "h"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "add_chart",
      "description": "在当前幻灯片中添加图表",
      "inputSchema": {
        "type": "object",
        "properties": {
          "options": {
            "type": "object",
            "additionalProperties": {}
          },
          "type": {
            "type": "string",
            "enum": [
              "area",
              "bar",
              "bar3D",
              "bubble",
              "doughnut",
              "line",
              "pie",
              "radar",
              "scatter"
            ],
            "description": "图表类型"
          },
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "数据系列名称"
                },
                "labels": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "标签数组"
                },
                "values": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "description": "数值数组"
                }
              },
              "required": [
                "name",
                "labels",
                "values"
              ],
              "additionalProperties": false
            },
            "description": "图表数据"
          },
          "x": {
            "type": "number",
            "description": "X坐标位置（英寸）"
          },
          "y": {
            "type": "number",
            "description": "Y坐标位置（英寸）"
          },
          "w": {
            "type": "number",
            "description": "图表宽度（英寸）"
          },
          "h": {
            "type": "number",
            "description": "图表高度（英寸）"
          },
          "title": {
            "type": "string",
            "description": "图表标题"
          },
          "showLegend": {
            "type": "boolean",
            "description": "是否显示图例"
          },
          "showTitle": {
            "type": "boolean",
            "description": "是否显示标题"
          }
        },
        "required": [
          "type",
          "data"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "add_media",
      "description": "在当前幻灯片中添加媒体（音频/视频）",
      "inputSchema": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "audio",
              "video"
            ],
            "description": "媒体类型"
          },
          "path": {
            "type": "string",
            "description": "媒体文件路径"
          },
          "data": {
            "type": "string",
            "description": "媒体的base64数据"
          },
          "link": {
            "type": "string",
            "description": "媒体链接URL"
          },
          "x": {
            "type": "number",
            "description": "X坐标位置（英寸）"
          },
          "y": {
            "type": "number",
            "description": "Y坐标位置（英寸）"
          },
          "w": {
            "type": "number",
            "description": "媒体宽度（英寸）"
          },
          "h": {
            "type": "number",
            "description": "媒体高度（英寸）"
          },
          "cover": {
            "type": "string",
            "description": "封面图片路径"
          },
          "volume": {
            "type": "number",
            "description": "音量(0-100)"
          },
          "autoPlay": {
            "type": "boolean",
            "description": "是否自动播放"
          },
          "loop": {
            "type": "boolean",
            "description": "是否循环播放"
          },
          "showControls": {
            "type": "boolean",
            "description": "是否显示控制条"
          }
        },
        "required": [
          "type",
          "x",
          "y",
          "w",
          "h"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "add_table",
      "description": "在当前幻灯片中添加表格",
      "inputSchema": {
        "type": "object",
        "properties": {
          "rows": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": "表格数据（二维数组）"
          },
          "x": {
            "type": "number",
            "description": "X坐标位置（英寸）"
          },
          "y": {
            "type": "number",
            "description": "Y坐标位置（英寸）"
          },
          "w": {
            "type": "number",
            "description": "表格宽度（英寸）"
          },
          "h": {
            "type": "number",
            "description": "表格高度（英寸）"
          },
          "colW": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "description": "列宽数组"
          },
          "rowH": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "description": "行高数组"
          },
          "align": {
            "type": "string",
            "enum": [
              "left",
              "center",
              "right"
            ],
            "description": "表格对齐方式"
          },
          "borderType": {
            "type": "string",
            "description": "边框类型"
          },
          "borderPt": {
            "type": "number",
            "description": "边框粗细"
          },
          "borderColor": {
            "type": "string",
            "description": "边框颜色"
          }
        },
        "required": [
          "rows"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "add_speaker_notes",
      "description": "Add presenter notes to the current slide",
      "inputSchema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "get_status",
      "description": "获取当前PPT会话状态",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    }
  ]
}