      },
      "text_boxes": 11,
      "notes_match": true,
      "notes": "L07-S02\n- Сопоставить три формата данных.\n- Веса меняются при обучении.\n- Это функциональные различия, а не обязательная одинаковая последовательность подготовки любой LLM.\nФрагмент лекции: При авторегрессионном предобучении",
      "missing_svg_fragments": [],
      "extra_pptx_fragments": [],
      "pdf_missing_fragments": [],
      "outside_shapes": [],
      "outside_pdf": []
    },
    {
